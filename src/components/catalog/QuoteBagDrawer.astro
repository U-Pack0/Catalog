---
import { getUI } from '../../lib/i18n';
import { localePath, type Lang } from '../../lib/url';
import { buildGeneralWhatsAppUrl } from '../../lib/whatsapp';
import Icon from '../icons/Icon.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = getUI(lang);
const catalogHref = localePath(lang, 'catalog');
const generalWaHref = buildGeneralWhatsAppUrl(lang);
---

<!-- Slide-Over Quote Bag Backdrop -->
<div
  id="quote-bag-backdrop"
  class="hidden fixed inset-0 z-50 bg-obsidian/55 backdrop-blur-xs"
  aria-hidden="true"
></div>

<!-- Slide-Over Quote Bag Drawer -->
<aside
  id="quote-bag-drawer"
  class="hidden fixed inset-y-0 end-0 z-50 flex w-full max-w-md flex-col border-s border-hairline bg-surface shadow-lg"
  role="dialog"
  aria-modal="true"
  aria-labelledby="quote-bag-title"
  aria-hidden="true"
>
  <!-- Drawer Header -->
  <div class="flex items-center justify-between gap-3 border-b border-hairline px-5 py-4">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-obsidian text-white">
        <Icon name="bag" size={18} />
      </span>
      <div>
        <h2 id="quote-bag-title" class="font-display text-base font-bold text-ink">
          {ui.bag.title}
        </h2>
        <p class="text-xs text-ink-muted">
          {ui.krnoDistributor} · <bdi dir="ltr">01055400404</bdi>
        </p>
      </div>
      <span
        id="quote-bag-header-count"
        class="inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-crimson px-2 font-mono text-xs font-bold text-white"
      >
        0
      </span>
    </div>

    <button
      type="button"
      class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-hairline bg-surface-muted text-ink-secondary transition-colors hover:border-hairline-strong hover:text-ink"
      data-close-bag
      aria-label={ui.bag.closeAria}
    >
      <Icon name="close" size={18} />
    </button>
  </div>

  <!-- Scrollable Drawer Content -->
  <div class="flex-1 overflow-y-auto p-5">
    <!-- Empty State -->
    <div
      id="quote-bag-empty"
      class="flex h-full flex-col items-center justify-center rounded-3xl border border-dashed border-hairline-strong bg-surface-muted/60 p-8 text-center"
    >
      <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-surface text-ink-muted shadow-xs">
        <Icon name="box" size={26} />
      </span>
      <h3 class="mt-4 font-display text-base font-bold text-ink">
        {ui.bag.emptyTitle}
      </h3>
      <p class="mt-1.5 max-w-xs text-xs leading-relaxed text-ink-muted">
        {ui.bag.emptyLead}
      </p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-2.5">
        <a
          href={catalogHref}
          class="inline-flex items-center gap-1.5 rounded-xl bg-obsidian px-4 py-2.5 text-xs font-bold text-white transition-colors hover:bg-obsidian-soft"
        >
          <span>{ui.actions.viewCatalog}</span>
          <Icon name="arrow-right" size={14} />
        </a>
        <a
          href={generalWaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-xl bg-wa px-4 py-2.5 text-xs font-bold text-white transition-colors hover:bg-wa-hover"
        >
          <Icon name="whatsapp" size={15} />
          <span>{ui.actions.orderWhatsApp}</span>
        </a>
      </div>
    </div>

    <!-- Populated Items List -->
    <ul id="quote-bag-items" class="hidden space-y-3" aria-live="polite"></ul>
  </div>

  <!-- Drawer Footer: Optional Business Info + WhatsApp Dispatch -->
  <div id="quote-bag-footer" class="hidden border-t border-hairline bg-surface-muted p-5">
    <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
      <div>
        <label for="quote-bag-business" class="sr-only">{ui.bag.businessPlaceholder}</label>
        <input
          id="quote-bag-business"
          type="text"
          placeholder={ui.bag.businessPlaceholder}
          class="w-full rounded-xl border border-hairline-strong bg-surface px-3 py-2 text-xs text-ink placeholder:text-ink-subtle focus:border-obsidian focus:outline-none"
        />
      </div>
      <div>
        <label for="quote-bag-city" class="sr-only">{ui.bag.cityPlaceholder}</label>
        <input
          id="quote-bag-city"
          type="text"
          placeholder={ui.bag.cityPlaceholder}
          class="w-full rounded-xl border border-hairline-strong bg-surface px-3 py-2 text-xs text-ink placeholder:text-ink-subtle focus:border-obsidian focus:outline-none"
        />
      </div>
    </div>

    <div class="mt-3.5 flex items-center justify-between text-xs">
      <span class="font-semibold text-ink-secondary">{ui.bag.totalLabel}</span>
      <span
        id="quote-bag-total-count"
        class="rounded-lg bg-surface px-2.5 py-1 font-mono text-xs font-bold text-ink shadow-2xs"
      >
        0
      </span>
    </div>

    <div class="mt-3.5 flex flex-col gap-2">
      <a
        id="quote-bag-send-wa"
        href={generalWaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-wa px-4 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-wa-hover"
      >
        <Icon name="whatsapp" size={18} />
        <span>{ui.bag.sendWhatsApp}</span>
      </a>

      <button
        type="button"
        class="inline-flex w-full items-center justify-center gap-1.5 rounded-xl border border-hairline bg-surface px-3 py-2 text-xs font-semibold text-ink-muted transition-colors hover:border-crimson/40 hover:text-crimson"
        data-clear-bag
      >
        <Icon name="trash" size={14} />
        <span>{ui.bag.clearBag}</span>
      </button>
    </div>
  </div>
</aside>

<script>
  import '../../scripts/quote-bag-drawer';
</script>
