---
import type { LidSpec, ProductFamily } from '../../data/catalog.schema';
import {
  UPACK_CONTACT,
  formatOrderQty,
  formatShortBox,
  formatSoldByBox,
  getUI,
} from '../../lib/i18n';
import { absUrl, localePath, withBase, type Lang } from '../../lib/url';
import { buildProductWhatsAppUrl } from '../../lib/whatsapp';
import Icon from '../icons/Icon.astro';

export interface Props {
  product: ProductFamily;
  lang: Lang;
  categoryName: string;
}

const { product, lang, categoryName } = Astro.props;
const ui = getUI(lang);

const v0 = product.variants[0] || {
  sku: product.slug.toUpperCase(),
  isSyntheticSku: true,
  label: product.name,
  orderUnit: 'box' as const,
};

const v0Image = v0.image || product.image;
const v0Backdrop = v0.photoBackdrop || product.photoBackdrop;
const productRelPath = localePath(lang, `product/${product.slug}`);
const productAbsUrl = absUrl(productRelPath, Astro.site);

const initialWaHref = buildProductWhatsAppUrl({
  lang,
  productName: product.name[lang],
  variantLabel: v0.label[lang],
  sku: v0.sku,
  isSyntheticSku: v0.isSyntheticSku,
  lidPolicy: product.lidPolicy,
  selectedLidSku: v0.lidSku,
  pcsPerBox: v0.pcsPerBox,
  packUnit: v0.packUnit,
  orderUnit: v0.orderUnit,
  productUrl: productAbsUrl,
});

const separateLids: LidSpec[] =
  product.separateLidOptions?.length
    ? product.separateLidOptions
    : product.lidPolicy === 'cups-no-lid-separate' && product.compatibleLids?.length
      ? product.compatibleLids
      : [];

const lidCalloutClass =
  product.lidPolicy === 'cups-no-lid-separate'
    ? 'border-amber-500/40 bg-amber-500/10 text-amber-950'
    : product.lidPolicy === 'built-in-hinged' || product.lidPolicy === 'included-set'
      ? 'border-wa/30 bg-wa/8 text-ink'
      : 'border-hairline-strong bg-surface-muted text-ink';

const showV0Sku = Boolean(v0.sku && !v0.isSyntheticSku);
const v0Dims = v0.dimensionsMm || v0.capacity || '—';
const v0Weight = v0.weightG != null ? `${v0.weightG} g` : '—';
const v0Color = v0.color?.[lang] || v0.color?.en || '—';
const v0Carton = v0.cartonSizeCm
  ? `${v0.cartonSizeCm} cm${v0.cbm ? ` (${v0.cbm} CBM)` : ''}`
  : v0.cbm
    ? `${v0.cbm} CBM`
    : '—';
const v0LidText = v0.lidSku
  ? `${v0.lidSku}${v0.lidSpecs?.[lang] ? ` (${v0.lidSpecs[lang]})` : ''}`
  : ui.lidBadges[product.lidPolicy];
---

<div
  class="flex flex-col gap-6"
  data-pdp-spec-panel
  data-slug={product.slug}
  data-name-en={product.name.en}
  data-name-ar={product.name.ar}
  data-category={product.category}
  data-lid-policy={product.lidPolicy}
  data-default-image={product.image}
  data-default-backdrop={product.photoBackdrop}
  data-product-url={productAbsUrl}
  data-variants={JSON.stringify(product.variants)}
>
  <!-- Top Meta Badges: Category + KRNO Distributor + Wholesale Sold by Box -->
  <div class="flex flex-wrap items-center gap-2">
    <a
      href={localePath(lang, `category/${product.category}`)}
      class="inline-flex items-center gap-1.5 rounded-full border border-hairline-strong bg-surface px-3 py-1 text-xs font-bold text-ink-secondary transition-colors hover:border-obsidian hover:text-ink"
    >
      <Icon name="grid" size={13} class="text-crimson" />
      <span>{categoryName}</span>
    </a>

    <span class="inline-flex items-center gap-1.5 rounded-full border border-crimson/25 bg-crimson/8 px-3 py-1 text-xs font-bold text-crimson">
      <span>{ui.krnoDistributor}</span>
    </span>

    <span
      id="pdp-header-box-badge"
      class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-obsidian px-3 py-1 font-mono text-xs font-bold text-white"
    >
      <Icon name="box" size={13} class="text-crimson" />
      <span id="pdp-header-box-text">
        {formatSoldByBox(lang, v0.pcsPerBox, v0.orderUnit, v0.packUnit)}
      </span>
    </span>
  </div>

  <!-- Product Title & Description -->
  <div>
    <h2 class="font-display text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
      {product.name[lang]}
    </h2>
    <p class="mt-1.5 text-sm font-semibold text-ink-secondary">
      {product.subtitle[lang]}
    </p>
    <p class="mt-3 text-sm leading-relaxed text-ink-muted">
      {product.description[lang]}
    </p>
  </div>

  <!-- Strict Lid Policy Callout Banner -->
  <div class={`flex items-start gap-3 rounded-2xl border p-4 ${lidCalloutClass}`}>
    <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-surface text-crimson shadow-2xs">
      <Icon
        name={product.lidPolicy === 'cups-no-lid-separate' ? 'info' : 'layers'}
        size={18}
      />
    </span>
    <div class="min-w-0 flex-1">
      <p class="font-display text-xs font-extrabold uppercase tracking-wider text-ink">
        {ui.lidBadges[product.lidPolicy]}
      </p>
      <p class="mt-0.5 text-xs leading-relaxed text-ink-secondary">
        {ui.lidNotes[product.lidPolicy]}
      </p>
    </div>
  </div>

  <!-- 1-Tap Variant Pill Selector -->
  {
    product.variants.length > 1 && (
      <div class="rounded-2xl border border-hairline bg-surface p-4 shadow-2xs">
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">
            {ui.catalog.chooseVariant}
          </span>
          <span class="font-mono text-xs font-semibold text-ink-subtle">
            {product.variants.length} {lang === 'ar' ? 'مقاسات' : 'options'}
          </span>
        </div>
        <div
          class="mt-3 flex flex-wrap items-center gap-2"
          role="group"
          aria-label={ui.catalog.chooseVariant}
        >
          {product.variants.map((variant, idx) => (
            <button
              type="button"
              class={`inline-flex items-center gap-1.5 rounded-xl border px-3.5 py-2 text-xs font-bold transition-all ${
                idx === 0
                  ? 'border-obsidian bg-obsidian text-white shadow-xs'
                  : 'border-hairline bg-surface-muted text-ink-secondary hover:border-hairline-strong hover:text-ink'
              }`}
              data-pdp-variant-btn
              data-variant-idx={idx}
              aria-pressed={idx === 0 ? 'true' : 'false'}
            >
              <span>{variant.label[lang]}</span>
              {variant.sku && !variant.isSyntheticSku && (
                <span class="rounded bg-black/15 px-1.5 py-0.5 font-mono text-[10px]">
                  <bdi dir="ltr">{variant.sku}</bdi>
                </span>
              )}
            </button>
          ))}
        </div>
      </div>
    )
  }

  <!-- Primary Wholesale Order Box: Quantity Stepper + Order on WhatsApp + Add Box to Quote Bag -->
  <div class="rounded-3xl border border-hairline-strong bg-surface p-5 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline pb-4">
      <div>
        <p class="text-xs font-semibold text-ink-muted">
          {ui.catalog.boxPackingLabel}
        </p>
        <p
          id="pdp-cta-packing-line"
          class="mt-0.5 font-mono text-base font-extrabold text-ink"
        >
          {formatSoldByBox(lang, v0.pcsPerBox, v0.orderUnit, v0.packUnit)}
        </p>
      </div>

      <!-- Box Quantity Stepper -->
      <div class="inline-flex items-center rounded-2xl border border-hairline-strong bg-surface-muted p-1">
        <button
          id="pdp-qty-minus"
          type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-xl text-ink transition-colors hover:bg-surface"
          aria-label={ui.bag.decreaseQtyAria}
        >
          <Icon name="minus" size={14} />
        </button>
        <span
          id="pdp-qty-display"
          class="min-w-[6.5rem] px-3 text-center font-mono text-xs font-extrabold text-ink"
          data-qty="1"
        >
          {formatOrderQty(lang, 1, v0.orderUnit)}
        </span>
        <button
          id="pdp-qty-plus"
          type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-xl text-ink transition-colors hover:bg-surface"
          aria-label={ui.bag.increaseQtyAria}
        >
          <Icon name="plus" size={14} />
        </button>
      </div>
    </div>

    <div class="mt-4 flex flex-col gap-2.5 sm:flex-row">
      <a
        id="pdp-order-wa"
        href={initialWaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-magnetic inline-flex flex-1 items-center justify-center gap-2 rounded-2xl bg-wa px-5 py-3.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-wa-hover"
      >
        <Icon name="whatsapp" size={19} />
        <span>{ui.actions.orderWhatsApp}</span>
        <span class="font-mono text-xs opacity-90">(<bdi dir="ltr">{UPACK_CONTACT.phone}</bdi>)</span>
      </a>

      <button
        id="pdp-add-bag"
        type="button"
        class="inline-flex items-center justify-center gap-2 rounded-2xl border border-obsidian bg-obsidian px-5 py-3.5 text-sm font-bold text-white transition-colors hover:bg-crimson hover:border-crimson"
        data-add-bag
        data-slug={product.slug}
        data-name-en={product.name.en}
        data-name-ar={product.name.ar}
        data-variant-en={v0.label.en}
        data-variant-ar={v0.label.ar}
        data-sku={v0.sku || ''}
        data-synthetic-sku={v0.isSyntheticSku ? 'true' : 'false'}
        data-lid-policy={product.lidPolicy}
        data-selected-lid-sku={v0.lidSku || ''}
        data-pcs-per-box={v0.pcsPerBox != null ? String(v0.pcsPerBox) : ''}
        data-pack-unit={v0.packUnit || ''}
        data-order-unit={v0.orderUnit || 'box'}
        data-quantity="1"
        data-image={v0Image}
        data-backdrop={v0Backdrop}
        data-path-en={`en/product/${product.slug}/`}
        data-path-ar={`ar/product/${product.slug}/`}
      >
        <Icon name="bag" size={17} />
        <span id="pdp-add-bag-label">
          {v0.orderUnit === 'pack' ? ui.actions.addPack : ui.actions.addBox}
        </span>
      </button>

      <a
        href={UPACK_CONTACT.telHref}
        class="inline-flex items-center justify-center gap-1.5 rounded-2xl border border-hairline-strong bg-surface-muted px-4 py-3.5 text-xs font-bold text-ink transition-colors hover:border-obsidian"
      >
        <Icon name="phone" size={16} class="text-crimson" />
        <span class="sr-only sm:not-sr-only">{ui.actions.callNow}</span>
      </a>
    </div>
  </div>

  <!-- Live Technical Specification Grid -->
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    <!-- Real SKU (Hidden if Synthetic) -->
    <div
      id="pdp-spec-sku-card"
      class={`rounded-2xl border border-hairline bg-surface p-3.5 ${showV0Sku ? '' : 'hidden'}`}
    >
      <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-subtle">
        {ui.catalog.skuLabel}
      </p>
      <p class="mt-1 font-mono text-sm font-extrabold text-ink">
        <bdi dir="ltr" id="pdp-spec-sku">{v0.sku}</bdi>
      </p>
    </div>

    <!-- Box Packing -->
    <div class="rounded-2xl border border-hairline bg-surface p-3.5">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-subtle">
        {ui.catalog.boxPackingLabel}
      </p>
      <p id="pdp-spec-box-packing" class="mt-1 font-mono text-sm font-extrabold text-crimson">
        {formatShortBox(lang, v0.pcsPerBox, v0.orderUnit, v0.packUnit)}
      </p>
    </div>

    <!-- Material -->
    <div class="rounded-2xl border border-hairline bg-surface p-3.5">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-subtle">
        {ui.catalog.materialLabel}
      </p>
      <p class="mt-1 font-mono text-sm font-bold text-ink">
        <bdi dir="ltr">{product.material.join(' / ')}</bdi>
      </p>
    </div>

    <!-- Dimensions / Capacity -->
    <div class="rounded-2xl border border-hairline bg-surface p-3.5">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-subtle">
        {ui.catalog.dimensionsLabel}
      </p>
      <p class="mt-1 font-mono text-sm font-bold text-ink">
        <bdi dir="ltr" id="pdp-spec-dimensions">{v0Dims}</bdi>
      </p>
    </div>

    <!-- Piece Weight -->
    <div class="rounded-2xl border border-hairline bg-surface p-3.5">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-subtle">
        {ui.catalog.weightLabel}
      </p>
      <p class="mt-1 font-mono text-sm font-bold text-ink">
        <bdi dir="ltr" id="pdp-spec-weight">{v0Weight}</bdi>
      </p>
    </div>

    <!-- Color -->
    <div class="rounded-2xl border border-hairline bg-surface p-3.5">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-subtle">
        {ui.catalog.colorLabel}
      </p>
      <p id="pdp-spec-color" class="mt-1 text-sm font-bold text-ink">
        {v0Color}
      </p>
    </div>

    <!-- Master Carton Size / CBM -->
    <div class="rounded-2xl border border-hairline bg-surface p-3.5">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-subtle">
        {ui.catalog.cartonSizeLabel}
      </p>
      <p class="mt-1 font-mono text-xs font-bold text-ink">
        <bdi dir="ltr" id="pdp-spec-carton-size">{v0Carton}</bdi>
      </p>
    </div>

    <!-- Paired Lid SKU / Policy -->
    <div class="rounded-2xl border border-hairline bg-surface p-3.5">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-subtle">
        {ui.catalog.lidSkuLabel}
      </p>
      <p id="pdp-spec-paired-lid" class="mt-1 font-mono text-xs font-bold text-ink-secondary">
        {v0LidText}
      </p>
    </div>
  </div>

  <!-- Multi-Variant Technical Comparison Table -->
  {
    product.variants.length > 1 && (
      <div class="overflow-hidden rounded-2xl border border-hairline bg-surface">
        <div class="overflow-x-auto">
          <table class="w-full text-start text-xs">
            <thead class="border-b border-hairline bg-surface-muted text-[11px] font-bold uppercase tracking-wider text-ink-muted">
              <tr>
                <th class="px-4 py-3 text-start">{ui.catalog.chooseVariant}</th>
                <th class="px-4 py-3 text-start">{ui.catalog.skuLabel}</th>
                <th class="px-4 py-3 text-start">{ui.catalog.dimensionsLabel}</th>
                <th class="px-4 py-3 text-start">{ui.catalog.weightLabel}</th>
                <th class="px-4 py-3 text-start">{ui.catalog.boxPackingLabel}</th>
                <th class="px-4 py-3 text-start">{ui.catalog.lidSkuLabel}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {product.variants.map((v, idx) => (
                <tr
                  class={`cursor-pointer transition-colors hover:bg-surface-muted/80 ${
                    idx === 0 ? 'bg-crimson/6 font-semibold' : ''
                  }`}
                  data-pdp-variant-row
                  data-variant-idx={idx}
                >
                  <td class="px-4 py-3 font-bold text-ink">{v.label[lang]}</td>
                  <td class="px-4 py-3 font-mono text-ink-secondary">
                    {v.sku && !v.isSyntheticSku ? <bdi dir="ltr">{v.sku}</bdi> : '—'}
                  </td>
                  <td class="px-4 py-3 font-mono text-ink-secondary">
                    <bdi dir="ltr">{v.dimensionsMm || v.capacity || '—'}</bdi>
                  </td>
                  <td class="px-4 py-3 font-mono text-ink-secondary">
                    {v.weightG != null ? <bdi dir="ltr">{v.weightG} g</bdi> : '—'}
                  </td>
                  <td class="px-4 py-3 font-mono font-bold text-crimson">
                    {formatShortBox(lang, v.pcsPerBox, v.orderUnit, v.packUnit)}
                  </td>
                  <td class="px-4 py-3 font-mono text-ink-muted">
                    {v.lidSku ? <bdi dir="ltr">{v.lidSku}</bdi> : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )
  }

  <!-- Separate Lid Boxes Section (For Cups Where Lids Come in Separate Master Boxes) -->
  {
    separateLids.length > 0 && (
      <div class="rounded-3xl border-2 border-amber-500/35 bg-amber-500/8 p-5">
        <div class="flex items-start gap-3">
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-obsidian text-white">
            <Icon name="layers" size={20} />
          </span>
          <div>
            <h3 class="font-display text-base font-extrabold text-ink">
              {ui.catalog.separateLidsHeading}
            </h3>
            <p class="mt-0.5 text-xs leading-relaxed text-ink-secondary">
              {ui.catalog.separateLidsNote}
            </p>
          </div>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-3">
          {separateLids.map((lid) => {
            const lidWaHref = buildProductWhatsAppUrl({
              lang,
              productName: `${lid.label[lang]} (${product.name[lang]})`,
              variantLabel: lid.sku,
              sku: lid.sku,
              isSyntheticSku: false,
              lidPolicy: 'standalone-lid',
              pcsPerBox: lid.pcsPerBox,
              orderUnit: 'box',
              productUrl: productAbsUrl,
            });

            return (
              <div class="flex flex-col justify-between gap-3 rounded-2xl border border-hairline bg-surface p-4 shadow-2xs sm:flex-row sm:items-center">
                <div class="flex items-center gap-3">
                  {lid.image && (
                    <div
                      class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl p-1.5 ${
                        (lid.photoBackdrop || product.photoBackdrop) === 'dark'
                          ? 'plinth-dark'
                          : 'plinth-light'
                      }`}
                    >
                      <img
                        src={withBase(lid.image)}
                        alt={lid.label[lang]}
                        width="48"
                        height="48"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-contain"
                      />
                    </div>
                  )}
                  <div>
                    <div class="flex flex-wrap items-center gap-1.5">
                      <span class="font-display text-sm font-bold text-ink">
                        {lid.label[lang]}
                      </span>
                      <span class="rounded-md bg-obsidian px-2 py-0.5 font-mono text-[11px] font-bold text-white">
                        <bdi dir="ltr">{lid.sku}</bdi>
                      </span>
                      <span class="rounded-md bg-surface-muted px-2 py-0.5 font-mono text-[11px] font-semibold text-ink-secondary">
                        <bdi dir="ltr">{lid.material}</bdi>
                      </span>
                    </div>
                    <div class="mt-1 flex flex-wrap items-center gap-2 font-mono text-xs text-ink-muted">
                      <span class="font-bold text-crimson">
                        {formatSoldByBox(lang, lid.pcsPerBox, 'box')}
                      </span>
                      {lid.dimensionsMm && (
                        <span>
                          · <bdi dir="ltr">{lid.dimensionsMm}</bdi>
                        </span>
                      )}
                      {lid.weightG != null && (
                        <span>
                          · <bdi dir="ltr">{lid.weightG} g</bdi>
                        </span>
                      )}
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-crimson bg-crimson px-3.5 py-2 text-xs font-bold text-white shadow-2xs transition-colors hover:bg-crimson-hover"
                    data-add-lid-bag
                    data-slug={`${product.slug}-lid-${lid.sku.toLowerCase()}`}
                    data-name-en={`${lid.label.en} (${product.name.en})`}
                    data-name-ar={`${lid.label.ar} (${product.name.ar})`}
                    data-variant-en={lid.sku}
                    data-variant-ar={lid.sku}
                    data-sku={lid.sku}
                    data-synthetic-sku="false"
                    data-lid-policy="standalone-lid"
                    data-pcs-per-box={lid.pcsPerBox != null ? String(lid.pcsPerBox) : ''}
                    data-order-unit="box"
                    data-image={lid.image || product.image}
                    data-backdrop={lid.photoBackdrop || product.photoBackdrop}
                    data-path-en={`en/product/${product.slug}/`}
                    data-path-ar={`ar/product/${product.slug}/`}
                  >
                    <span>{ui.actions.addLidBox}</span>
                  </button>

                  <a
                    href={lidWaHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-1 rounded-xl bg-wa px-3 py-2 text-xs font-bold text-white transition-colors hover:bg-wa-hover"
                  >
                    <Icon name="whatsapp" size={14} />
                    <span>{ui.actions.orderWhatsApp}</span>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )
  }
</div>

<script>
  import type { ProductVariant } from '../../data/catalog.schema';
  import {
    formatOrderQty,
    formatShortBox,
    formatSoldByBox,
    getUI,
    type LidPolicy,
  } from '../../lib/i18n';
  import type { Lang } from '../../lib/url';
  import { buildProductWhatsAppUrl } from '../../lib/whatsapp';
  import { animateMetricPop } from '../../scripts/motion-controller';

  function resolveWithBase(path: string): string {
    if (!path) return '/';
    if (/^(https?:|mailto:|tel:|data:|#)/i.test(path)) return path;
    const baseRaw = document.documentElement.dataset.base || '/';
    const base = baseRaw.endsWith('/') ? baseRaw : `${baseRaw}/`;
    const clean = path.replace(/^\/+/, '');
    const baseNoLead = base.replace(/^\/+/, '');
    if (baseNoLead && clean.startsWith(baseNoLead)) {
      return `/${clean}`;
    }
    return `${base}${clean}`;
  }

  function initVariantSpecTable(): void {
    const panel = document.querySelector<HTMLElement>('[data-pdp-spec-panel]');
    if (!panel) return;

    const lang: Lang = document.documentElement.lang === 'ar' ? 'ar' : 'en';
    const ui = getUI(lang);
    const variantsRaw = panel.getAttribute('data-variants');
    if (!variantsRaw) return;

    let variants: ProductVariant[] = [];
    try {
      variants = JSON.parse(variantsRaw);
    } catch {
      return;
    }

    let currentIdx = 0;
    let currentQty = 1;

    const qtyMinus = document.getElementById('pdp-qty-minus');
    const qtyPlus = document.getElementById('pdp-qty-plus');
    const qtyDisplay = document.getElementById('pdp-qty-display');
    const addBagBtn = document.getElementById('pdp-add-bag');
    const addBagLabel = document.getElementById('pdp-add-bag-label');
    const orderWaBtn = document.getElementById('pdp-order-wa') as HTMLAnchorElement | null;

    function syncQuantityUI() {
      const v = variants[currentIdx] || variants[0];
      const unit = v?.orderUnit || 'box';
      if (qtyDisplay) {
        qtyDisplay.dataset.qty = String(currentQty);
        qtyDisplay.textContent = formatOrderQty(lang, currentQty, unit);
      }
      if (addBagBtn) {
        addBagBtn.dataset.quantity = String(currentQty);
      }
    }

    function selectVariant(idx: number) {
      const v = variants[idx];
      if (!v) return;
      currentIdx = idx;

      const nameEn = panel!.dataset.nameEn || '';
      const nameAr = panel!.dataset.nameAr || nameEn;
      const lidPolicy = (panel!.dataset.lidPolicy as LidPolicy) || 'no-lid';
      const defaultImage = panel!.dataset.defaultImage || '';
      const defaultBackdrop = panel!.dataset.defaultBackdrop || 'light';
      const productUrl = panel!.dataset.productUrl || window.location.href;

      // 1. Update pill buttons
      panel!.querySelectorAll<HTMLElement>('[data-pdp-variant-btn]').forEach((btn, i) => {
        const active = i === idx;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('border-obsidian', active);
        btn.classList.toggle('bg-obsidian', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('shadow-xs', active);
        btn.classList.toggle('border-hairline', !active);
        btn.classList.toggle('bg-surface-muted', !active);
        btn.classList.toggle('text-ink-secondary', !active);
      });

      // 2. Update comparison table rows
      panel!.querySelectorAll<HTMLElement>('[data-pdp-variant-row]').forEach((row, i) => {
        row.classList.toggle('bg-crimson/6', i === idx);
        row.classList.toggle('font-semibold', i === idx);
      });

      // 3. Update live spec cells
      const skuCard = document.getElementById('pdp-spec-sku-card');
      const skuEl = document.getElementById('pdp-spec-sku');
      if (skuCard && skuEl) {
        if (v.sku && !v.isSyntheticSku) {
          skuEl.textContent = v.sku;
          skuCard.classList.remove('hidden');
          animateMetricPop(skuEl);
        } else {
          skuCard.classList.add('hidden');
        }
      }

      const soldByBoxText = formatSoldByBox(lang, v.pcsPerBox, v.orderUnit, v.packUnit);
      const shortBoxText = formatShortBox(lang, v.pcsPerBox, v.orderUnit, v.packUnit);

      const headerBoxText = document.getElementById('pdp-header-box-text');
      const ctaPackingLine = document.getElementById('pdp-cta-packing-line');
      const specBoxPacking = document.getElementById('pdp-spec-box-packing');

      if (headerBoxText) headerBoxText.textContent = soldByBoxText;
      if (ctaPackingLine) {
        ctaPackingLine.textContent = soldByBoxText;
        animateMetricPop(ctaPackingLine);
      }
      if (specBoxPacking) {
        specBoxPacking.textContent = shortBoxText;
        animateMetricPop(specBoxPacking);
      }

      const dimsEl = document.getElementById('pdp-spec-dimensions');
      if (dimsEl) dimsEl.textContent = v.dimensionsMm || v.capacity || '—';

      const weightEl = document.getElementById('pdp-spec-weight');
      if (weightEl) weightEl.textContent = v.weightG != null ? `${v.weightG} g` : '—';

      const colorEl = document.getElementById('pdp-spec-color');
      if (colorEl) colorEl.textContent = v.color?.[lang] || v.color?.en || '—';

      const cartonEl = document.getElementById('pdp-spec-carton-size');
      if (cartonEl) {
        cartonEl.textContent = v.cartonSizeCm
          ? `${v.cartonSizeCm} cm${v.cbm ? ` (${v.cbm} CBM)` : ''}`
          : v.cbm
            ? `${v.cbm} CBM`
            : '—';
      }

      const pairedLidEl = document.getElementById('pdp-spec-paired-lid');
      if (pairedLidEl) {
        pairedLidEl.textContent = v.lidSku
          ? `${v.lidSku}${v.lidSpecs?.[lang] ? ` (${v.lidSpecs[lang]})` : ''}`
          : ui.lidBadges[lidPolicy];
      }

      // 4. Update Order on WhatsApp href & Add Box payload
      const productName = lang === 'ar' ? nameAr : nameEn;
      const variantLabel = v.label[lang] || v.label.en;

      if (orderWaBtn) {
        orderWaBtn.href = buildProductWhatsAppUrl({
          lang,
          productName,
          variantLabel,
          sku: v.sku,
          isSyntheticSku: v.isSyntheticSku,
          lidPolicy,
          selectedLidSku: v.lidSku,
          pcsPerBox: v.pcsPerBox,
          packUnit: v.packUnit,
          orderUnit: v.orderUnit,
          productUrl,
        });
      }

      const nextImgRaw = v.image || defaultImage;
      const nextBackdrop = v.photoBackdrop || defaultBackdrop;

      if (addBagBtn) {
        addBagBtn.dataset.variantEn = v.label.en;
        addBagBtn.dataset.variantAr = v.label.ar;
        addBagBtn.dataset.sku = v.sku || '';
        addBagBtn.dataset.syntheticSku = v.isSyntheticSku ? 'true' : 'false';
        addBagBtn.dataset.selectedLidSku = v.lidSku || '';
        addBagBtn.dataset.pcsPerBox = v.pcsPerBox != null ? String(v.pcsPerBox) : '';
        addBagBtn.dataset.packUnit = v.packUnit || '';
        addBagBtn.dataset.orderUnit = v.orderUnit || 'box';
        addBagBtn.dataset.image = nextImgRaw;
        addBagBtn.dataset.backdrop = nextBackdrop;
      }

      if (addBagLabel) {
        addBagLabel.textContent =
          v.orderUnit === 'pack' ? ui.actions.addPack : ui.actions.addBox;
      }

      syncQuantityUI();

      // 5. Notify ProductDetailStage to sync photo & box badge
      window.dispatchEvent(
        new CustomEvent('upack:pdp-variant-change', {
          detail: {
            variant: v,
            imageSrc: resolveWithBase(nextImgRaw),
            backdrop: nextBackdrop,
            soldByBoxText,
          },
        })
      );
    }

    panel.querySelectorAll<HTMLElement>('[data-pdp-variant-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-variant-idx') || '0');
        selectVariant(idx);
      });
    });

    panel.querySelectorAll<HTMLElement>('[data-pdp-variant-row]').forEach((row) => {
      row.addEventListener('click', () => {
        const idx = Number(row.getAttribute('data-variant-idx') || '0');
        selectVariant(idx);
      });
    });

    qtyMinus?.addEventListener('click', () => {
      currentQty = Math.max(1, currentQty - 1);
      syncQuantityUI();
    });

    qtyPlus?.addEventListener('click', () => {
      currentQty = Math.min(999, currentQty + 1);
      syncQuantityUI();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVariantSpecTable, { once: true });
  } else {
    initVariantSpecTable();
  }
  document.addEventListener('astro:page-load', initVariantSpecTable);
</script>
