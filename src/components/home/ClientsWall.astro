---
import type { ClientLogo } from '../../data/catalog.schema';
import { withBase, type Lang } from '../../lib/url';
import { getUI } from '../../lib/i18n';

export interface Props {
  lang: Lang;
  clients: ClientLogo[];
}

const { lang, clients } = Astro.props;
const ui = getUI(lang);
---

<section
  id="our-clients"
  class="clients-wall-section"
  data-reveal-section
  aria-labelledby="clients-wall-heading"
>
  <div class="clients-container">
    <div class="clients-header">
      <h2 id="clients-wall-heading" class="clients-h2">{ui.clients.title}</h2>
      <p class="clients-lead">{ui.clients.lead}</p>
    </div>

    <!-- Proud Permanent 3x3 Porcelain Medallion Grid (All 9 Clients Intact, Full Color, Zero Crop) -->
    <div class="clients-grid">
      {clients.map((client) => (
        <div class="client-medallion" data-reveal-card>
          <div class="client-logo-well">
            <img
              src={withBase(client.image)}
              alt={client.name[lang]}
              width="160"
              height="96"
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="client-brand-name">{client.name[lang]}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clients-wall-section {
    padding: 64px 20px;
    background-color: var(--color-gallery, #F5F7FA);
    border-bottom: 1px solid var(--color-hairline, #E2E6EF);
  }

  @media (min-width: 1024px) {
    .clients-wall-section {
      padding: 84px 28px;
    }
  }

  .clients-container {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: 4px;
  }

  .clients-header {
    max-width: 680px;
    margin-bottom: 32px;
  }

  .clients-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.1vw, 2.55rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--color-ink, #0D0F14);
    margin: 0;
  }

  :global(html[dir='rtl']) .clients-h2 {
    letter-spacing: 0;
    line-height: 1.26;
  }

  .clients-lead {
    margin: 10px 0 0;
    font-size: 1rem;
    color: var(--color-ink-muted, #4B5366);
    line-height: 1.62;
  }

  .clients-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  @media (min-width: 640px) {
    .clients-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  .client-medallion {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 16px;
    border-radius: 18px;
    background-color: #FFFFFF;
    border: 1px solid var(--color-hairline, #E2E6EF);
    box-shadow: var(--shadow-card);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.2s ease;
  }

  .client-medallion:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-hairline-strong, #CBD3E1);
  }

  @media (max-width: 639px) {
    .client-medallion:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      max-width: calc(50% - 8px);
      width: 100%;
      justify-self: center;
    }
  }

  /* Full color, zero grayscale, zero invert, zero dark tint, zero cropping */
  .client-logo-well {
    width: 100%;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
  }

  @media (min-width: 640px) {
    .client-logo-well {
      height: 112px;
    }
  }

  .client-logo-well img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    display: block;
  }

  .client-brand-name {
    font-family: var(--font-display);
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--color-ink, #0D0F14);
    text-align: center;
    line-height: 1.3;
  }
</style>
