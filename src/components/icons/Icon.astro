---
export type IconName = 'whatsapp' | 'phone' | 'mail' | 'bag' | 'box' | 'search' | 'close' | 'menu' | 'arrow-right' | 'arrow-left' | 'arrow-up' | 'arrow-up-right' | 'chevron-down' | 'check' | 'plus' | 'minus' | 'trash' | 'sparkle' | 'layers' | 'eye' | 'flip' | 'zoom' | 'globe' | 'truck' | 'cake' | 'cup' | 'grid' | 'filter' | 'info' | 'share';

export interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 18, class: className = '', label } = Astro.props;

const DIRECTIONAL = new Set<IconName>(['arrow-right', 'arrow-left', 'arrow-up-right']);
const isDirectional = DIRECTIONAL.has(name);
const isWhatsApp = name === 'whatsapp';
const combinedClass = [isDirectional ? 'icon-dir' : '', 'shrink-0', className]
  .filter(Boolean)
  .join(' ');
---

