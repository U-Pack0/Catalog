---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaterialShowcase from '../../components/home/MaterialShowcase.astro';
import ClientsWall from '../../components/home/ClientsWall.astro';
import WholesaleBanner from '../../components/home/WholesaleBanner.astro';
import QuoteBagDrawer from '../../components/catalog/QuoteBagDrawer.astro';
import Icon from '../../components/icons/Icon.astro';

import rawCatalog from '../../data/catalog.json';
import type { CatalogData } from '../../data/catalog.schema';
import { absUrl, localePath, withBase, type Lang } from '../../lib/url';
import { UPACK_CONTACT, getUI } from '../../lib/i18n';
import { buildGeneralWhatsAppUrl } from '../../lib/whatsapp';
import { EGYPT_SEO_KEYWORDS, buildBreadcrumbJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
}

const { lang } = Astro.params as { lang: Lang };
const isAr = lang === 'ar';
const ui = getUI(lang);
const catalogData = rawCatalog as unknown as CatalogData;

const canonicalPath = localePath(lang, 'about');
const breadcrumbLd = buildBreadcrumbJsonLd([
  { name: ui.nav.home, url: absUrl(localePath(lang), Astro.site) },
  { name: ui.nav.about, url: absUrl(canonicalPath, Astro.site) }
]);

const copy = isAr
  ? {
      h1: 'يو-باك للتجارة — موزع KRNO لعبوات التغليف الغذائي في مصر',
      intro: 'تتخصص شركة يو-باك للتجارة في توريد عبوات تغليف الأغذية والحلويات والمشروبات من علامة KRNO بالجملة بالكرتونة للمطاعم، الكافيهات، محلات الحلويات والباتيسيري، والمطابخ السحابية في جميع محافظات مصر.',
      missionTitle: 'توريد جملة منظم بالكرتونة بدون تعقيد',
      missionBody: 'بدلاً من القوائم المربكة أو البطاقات المكررة، صممنا كتالوج يو-باك ليعرض كل منتج بمواصفاته الحقيقية من كتالوج KRNO: الكود الدقيق، عدد القطع في الكرتونة، أبعاد العبوة، ونظام الغطاء المطابق.',
      dessertFocusTitle: 'تركيز خاص على قطاع الحلويات والباتيسيري',
      dessertFocusBody: 'نوفر أكبر تشكيلة متكاملة لمحلات الحلويات في مصر تشمل صواني الحلويات الكريستالية PS، علب الكيك والتورتة بأغطية بومبيه متعددة الارتفاعات، وأكواب الحلو والجيلي والآيس كريم.',
      statsCategories: 'فئة متخصصة',
      statsFamilies: 'خط إنتاج',
      statsSkus: 'كود SKU معتمد',
      statsDelivery: 'تغطية التوصيل',
      statsDeliveryVal: 'كل محافظات مصر',
      ctaCatalog: 'تصفح الكتالوج الكامل',
      ctaWa: 'تواصل عبر واتساب'
    }
  : {
      h1: 'U-Pack for Trading — KRNO Distributor for Food & Dessert Packaging in Egypt',
      intro: 'U-Pack for Trading supplies KRNO disposable food-service and patisserie packaging by the master box to restaurants, cafés, dessert shops, bakeries, and cloud kitchens across all governorates of Egypt.',
      missionTitle: 'Transparent Master-Box Wholesale Supply',
      missionBody: 'Every product family in our catalog is organized directly around verified KRNO master-box specifications: exact SKU code, pieces per box, millimeter dimensions, material resin, and clear lid pairing rules.',
      dessertFocusTitle: 'Dedicated Patisserie & Dessert Packaging Depth',
      dessertFocusBody: 'Because dessert and bakery presentation demands crystal clarity and structural rigidity, we stock an extensive lineup of PS dessert trays, multi-height cake dome boxes, parfait cups, and sweet bowls.',
      statsCategories: 'Categories',
      statsFamilies: 'Product Lines',
      statsSkus: 'Verified SKUs',
      statsDelivery: 'Delivery Reach',
      statsDeliveryVal: 'All of Egypt',
      ctaCatalog: 'Browse Full Catalog',
      ctaWa: 'Order on WhatsApp'
    };
---

<BaseLayout
  lang={lang}
  title={ui.seo.aboutTitle}
  description={ui.seo.aboutDescription}
  canonicalPath={canonicalPath}
  keywords={EGYPT_SEO_KEYWORDS[lang]}
  jsonLd={[breadcrumbLd]}
>
  <section class="about-hero-section">
    <div class="about-container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href={localePath(lang)} class="breadcrumb-link">{ui.nav.home}</a>
        <span aria-hidden="true">/</span>
        <span class="breadcrumb-current" aria-current="page">{ui.nav.about}</span>
      </nav>

      <div class="about-hero-grid">
        <div class="about-hero-copy">
          <div class="about-badges">
            <span class="about-badge is-crimson">{ui.krnoDistributor}</span>
            <span class="about-badge">{ui.deliveryNationwide}</span>
          </div>

          <h1 class="about-h1">{copy.h1}</h1>
          <p class="about-intro">{copy.intro}</p>

          <div class="about-actions">
            <a href={localePath(lang, 'catalog')} class="about-btn-primary">
              <span>{copy.ctaCatalog}</span>
              <Icon name="arrow-right" size={16} />
            </a>
            <a
              href={buildGeneralWhatsAppUrl(lang)}
              target="_blank"
              rel="noopener noreferrer"
              class="about-btn-wa"
            >
              <Icon name="whatsapp" size={18} />
              <span>{copy.ctaWa} · <bdi dir="ltr" class="font-mono-tech">{UPACK_CONTACT.phone}</bdi></span>
            </a>
          </div>
        </div>

        <div class="about-brand-panel">
          <div class="about-logos-row">
            <img
              src={withBase(catalogData.brand.logoWebp || '/images/brand/upack-logo.jpg')}
              alt={ui.brandName}
              width="96"
              height="96"
              class="about-upack-emblem"
            />
            <div class="about-krno-chip">
              <img
                src={withBase(catalogData.brand.krnoLogoWebp || '/images/brand/krno-logo.png')}
                alt="KRNO"
                width="120"
                height="42"
              />
              <span>{ui.krnoDistributor}</span>
            </div>
          </div>

          <dl class="about-stats-grid">
            <div class="about-stat-cell">
              <dt class="about-stat-k">{copy.statsCategories}</dt>
              <dd class="about-stat-v">{catalogData.stats.categories}</dd>
            </div>
            <div class="about-stat-cell">
              <dt class="about-stat-k">{copy.statsFamilies}</dt>
              <dd class="about-stat-v">{catalogData.stats.families}</dd>
            </div>
            <div class="about-stat-cell">
              <dt class="about-stat-k">{copy.statsSkus}</dt>
              <dd class="about-stat-v">{catalogData.stats.totalUniqueSkus}</dd>
            </div>
            <div class="about-stat-cell">
              <dt class="about-stat-k">{copy.statsDelivery}</dt>
              <dd class="about-stat-v is-text">{copy.statsDeliveryVal}</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Asymmetric 2-Column Editorial Pillars -->
      <div class="about-pillars-grid">
        <article class="about-pillar">
          <h2 class="about-pillar-h2">{copy.missionTitle}</h2>
          <p class="about-pillar-body">{copy.missionBody}</p>
        </article>
        <article class="about-pillar">
          <h2 class="about-pillar-h2">{copy.dessertFocusTitle}</h2>
          <p class="about-pillar-body">{copy.dessertFocusBody}</p>
        </article>
      </div>
    </div>
  </section>

  <MaterialShowcase lang={lang} />

  <ClientsWall lang={lang} clients={catalogData.clients} />

  <WholesaleBanner lang={lang} />

  <QuoteBagDrawer slot="drawer" lang={lang} />
</BaseLayout>

<style>
  .about-hero-section {
    padding: 36px 20px 68px;
    background-color: var(--color-surface, #FFFFFF);
    border-bottom: 1px solid var(--color-hairline, #E2E6EF);
  }

  @media (min-width: 1024px) {
    .about-hero-section {
      padding: 48px 28px 84px;
    }
  }

  .about-container {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: 4px;
  }

  .breadcrumb-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-ink-muted, #4B5366);
    margin-bottom: 22px;
  }

  .breadcrumb-link {
    color: var(--color-ink-secondary, #374051);
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    color: var(--color-crimson, #C61D2A);
  }

  .breadcrumb-current {
    color: var(--color-ink, #0D0F14);
    font-weight: 700;
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .about-hero-grid {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 44px;
    }
  }

  .about-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .about-badge {
    padding: 4px 12px;
    border-radius: 9999px;
    background-color: var(--color-gallery, #F5F7FA);
    border: 1px solid var(--color-hairline, #E2E6EF);
    color: var(--color-ink-secondary, #374051);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .about-badge.is-crimson {
    background-color: var(--color-crimson-soft, #FDECEE);
    border-color: rgba(198, 29, 42, 0.25);
    color: var(--color-crimson, #C61D2A);
    font-weight: 800;
  }

  .about-h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.5vw, 2.85rem);
    font-weight: 800;
    line-height: 1.13;
    letter-spacing: -0.025em;
    color: var(--color-ink, #0D0F14);
    margin: 0;
  }

  :global(html[dir='rtl']) .about-h1 {
    letter-spacing: 0;
    line-height: 1.28;
  }

  .about-intro {
    margin: 14px 0 0;
    font-size: 1.05rem;
    color: var(--color-ink-muted, #4B5366);
    line-height: 1.65;
    max-width: 60ch;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .about-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 12px;
    background-color: var(--color-obsidian, #0D0F14);
    color: #FFFFFF;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.16s ease;
  }

  .about-btn-primary:hover {
    background-color: var(--color-crimson, #C61D2A);
  }

  .about-btn-wa {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 12px;
    background-color: var(--color-wa, #127A3E);
    color: #FFFFFF;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.16s ease;
  }

  .about-btn-wa:hover {
    background-color: var(--color-wa-hover, #0D6130);
  }

  .about-brand-panel {
    padding: 28px 24px;
    border-radius: 20px;
    background-color: var(--color-gallery, #F5F7FA);
    border: 1px solid var(--color-hairline, #E2E6EF);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .about-logos-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .about-upack-emblem {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--color-obsidian, #0D0F14);
  }

  .about-krno-chip {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    border-radius: 14px;
    background-color: #FFFFFF;
    border: 1px solid var(--color-hairline, #E2E6EF);
  }

  .about-krno-chip img {
    height: 28px;
    width: auto;
    object-fit: contain;
  }

  .about-krno-chip span {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--color-ink-secondary, #374051);
  }

  .about-stats-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--color-hairline, #E2E6EF);
  }

  .about-stat-cell {
    display: flex;
    flex-direction: column-reverse;
    gap: 3px;
  }

  .about-stat-v {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--color-ink, #0D0F14);
  }

  .about-stat-v.is-text {
    font-size: 1.15rem;
    color: var(--color-crimson, #C61D2A);
  }

  .about-stat-k {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-ink-muted, #4B5366);
  }

  .about-pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--color-hairline, #E2E6EF);
  }

  @media (min-width: 820px) {
    .about-pillars-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 28px;
    }
  }

  .about-pillar {
    padding: 24px;
    border-radius: 18px;
    background-color: var(--color-gallery, #F5F7FA);
    border: 1px solid var(--color-hairline, #E2E6EF);
  }

  .about-pillar-h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-ink, #0D0F14);
    margin: 0 0 10px;
  }

  .about-pillar-body {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-ink-muted, #4B5366);
    line-height: 1.64;
  }
</style>
