---
import '../styles/tokens.css';
import '../styles/global.css';
import Icon from '../components/icons/Icon.astro';
import { localePath, withBase } from '../lib/url';
import { UPACK_CONTACT } from '../lib/i18n';
import { buildGeneralWhatsAppUrl } from '../lib/whatsapp';

const arCatalog = localePath('ar', 'catalog');
const enCatalog = localePath('en', 'catalog');
const arHome = localePath('ar');
const enHome = localePath('en');
const waHref = buildGeneralWhatsAppUrl('en');
---

<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <title>404 — Page Not Found | U-Pack for Trading</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alexandria:wght@700;800&family=Bricolage+Grotesque:wght@700;800&family=Manrope:wght@500;600;700&family=Tajawal:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="arch-cyclorama flex min-h-dvh items-center justify-center p-6 text-ink">
    <main class="w-full max-w-xl rounded-3xl border border-hairline bg-white p-8 text-center shadow-[var(--shadow-card-hover)] sm:p-11">
      <div class="mx-auto mb-5 size-16 overflow-hidden rounded-full border border-hairline-strong bg-obsidian">
        <img
          src={withBase('/images/brand/upack-logo.webp')}
          alt="U-Pack for Trading"
          width="64"
          height="64"
          class="size-full object-cover"
        />
      </div>

      <p class="font-mono-tech text-sm font-bold text-crimson">404</p>
      <h1 class="mt-2 font-display text-3xl font-extrabold text-ink sm:text-4xl">
        Page Not Found
      </h1>
      <p class="mt-1 font-display text-xl font-bold text-ink-secondary" dir="rtl" lang="ar">
        الصفحة المطلوبة غير موجودة
      </p>
      <p class="mx-auto mt-3 max-w-md text-sm text-ink-muted">
        Explore our complete bilingual KRNO food &amp; dessert packaging catalog or message us directly on WhatsApp.
      </p>

      <div class="mt-7 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <a
          href={enCatalog}
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-obsidian px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-crimson"
        >
          <span>Browse English Catalog</span>
          <Icon name="arrow-right" size={16} />
        </a>
        <a
          href={arCatalog}
          dir="rtl"
          lang="ar"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-crimson px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-crimson-hover"
        >
          <span>تصفح الكتالوج بالعربية</span>
        </a>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
        <a
          href={waHref}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-wa px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-wa-hover"
        >
          <Icon name="whatsapp" size={17} />
          <span>WhatsApp {UPACK_CONTACT.phone}</span>
        </a>
        <a
          href={enHome}
          class="inline-flex min-h-11 items-center rounded-xl border border-hairline px-4 py-2.5 text-sm font-semibold text-ink-secondary hover:bg-surface-alt"
        >
          EN Home
        </a>
        <a
          href={arHome}
          dir="rtl"
          lang="ar"
          class="inline-flex min-h-11 items-center rounded-xl border border-hairline px-4 py-2.5 text-sm font-semibold text-ink-secondary hover:bg-surface-alt"
        >
          الرئيسية
        </a>
      </div>
    </main>
  </body>
</html>
